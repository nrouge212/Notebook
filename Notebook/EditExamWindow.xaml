<Window x:Class="Notebook.EditExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Créer un examen" Height="380" Width="450"
        Background="#FFFFFF" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Label Content="Module :" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox x:Name="moduleCombo" Grid.Row="0" Grid.Column="1" Margin="0,5,0,5" Height="32"/>
        
        <Label Content="Enseignant :" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="teacherText" Grid.Row="1" Grid.Column="1" Margin="0,5,0,5" Height="32"/>

        <Label Content="Date de l'examen :" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <DatePicker x:Name="datePicker" Grid.Row="2" Grid.Column="1" Margin="0,5,0,5" Height="32" VerticalContentAlignment="Center"/>

        <Label Content="Statut :" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <CheckBox x:Name="absentCheck" Content="L'étudiant était absent" Grid.Row="3" Grid.Column="1" Margin="0,12,0,12" 
                  VerticalAlignment="Center" Click="CheckAbsent" Foreground="#374151" Cursor="Hand"/>

        <Label Content="Note (sur 20) :" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="scoreText" Grid.Row="4" Grid.Column="1" Margin="0,5,0,5" Height="32" Width="80" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annuler" Width="100" Background="#9CA3AF" Margin="0,0,15,0" Click="Cancel"/>
            <Button Content="Valider" Width="100" Background="#10B981" Click="Validate"/>
        </StackPanel>
    </Grid>
</Window>