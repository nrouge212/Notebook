<Window x:Class="Notebook.ListExamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liste des examens" Height="400" Width="600"
        Background="#FFFFFF" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="5,0,5,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Date" FontWeight="Bold" Foreground="#6B7280"/>
            <Label Grid.Column="1" Content="Module" FontWeight="Bold" Foreground="#6B7280"/>
            <Label Grid.Column="2" Content="Enseignant" FontWeight="Bold" Foreground="#6B7280"/>
            <Label Grid.Column="3" Content="Note" FontWeight="Bold" Foreground="#6B7280"/>
        </Grid>

        <ListBox x:Name="exams" Grid.Row="1" HorizontalContentAlignment="Stretch" Margin="0,0,0,20">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{Binding Date, StringFormat=d}" />
                        <Label Grid.Column="1" Content="{Binding Module.Name}" />
                        <Label Grid.Column="2" Content="{Binding Teacher}" />
                        <Label Grid.Column="3" Content="{Binding Note}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Fermer" Grid.Row="2" Width="100" HorizontalAlignment="Center" Background="#9CA3AF" Click="CloseWindow"/>
    </Grid>
</Window>