<Window x:Class="Notebook.ListExamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liste des examens et moyennes" Height="550" Width="600"
        Background="#FFFFFF" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Ligne 0 : En-têtes -->
            <RowDefinition Height="1.5*"/>
            <!-- Ligne 1 : Liste des examens -->
            <RowDefinition Height="Auto"/>
            <!-- Ligne 2 : Titre/Espace pour les moyennes -->
            <RowDefinition Height="*"/>
            <!-- Ligne 3 : Liste des moyennes -->
            <RowDefinition Height="Auto"/>
            <!-- Ligne 4 : Bouton Fermer -->
        </Grid.RowDefinitions>

        <!-- En-têtes des colonnes examens -->
        <Grid Grid.Row="0" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Date" FontWeight="Bold" Foreground="#6B7280"/>
            <Label Grid.Column="1" Content="Module" FontWeight="Bold" Foreground="#6B7280"/>
            <Label Grid.Column="2" Content="Enseignant" FontWeight="Bold" Foreground="#6B7280"/>
            <Label Grid.Column="3" Content="Note" FontWeight="Bold" Foreground="#6B7280"/>
        </Grid>

        <!-- Liste des examens -->
        <ListBox x:Name="exams" Grid.Row="1" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{Binding Date, StringFormat=d}" />
                        <Label Grid.Column="1" Content="{Binding Module.Name}" />
                        <Label Grid.Column="2" Content="{Binding Teacher}" />
                        <Label Grid.Column="3" Content="{Binding Note}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Label Content="Moyennes par module, par UE et générale :" Grid.Row="2" FontWeight="Bold" Foreground="#374151" Margin="0,5,0,5"/>

        <ListBox x:Name="scores" Grid.Row="3" Background="#F3F4F6" Margin="0,0,0,15"/>

        <Button Content="Fermer" Grid.Row="4" Width="100" HorizontalAlignment="Center" Background="#9CA3AF" Click="CloseWindow"/>
    </Grid>
</Window>