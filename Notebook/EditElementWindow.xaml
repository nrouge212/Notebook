<Window x:Class="Notebook.EditElementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Educational Element" Height="250" Width="350">
    <Grid>
        <Label Content="Name :" HorizontalAlignment="Left" Margin="20,20,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="name" HorizontalAlignment="Left" Margin="100,24,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Coeficient :" HorizontalAlignment="Left" Margin="20,70,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="coef" HorizontalAlignment="Left" Margin="100,74,0,0" VerticalAlignment="Top" Width="100"/>

        <Button Content="Validate" HorizontalAlignment="Center" Margin="0,130,0,0" VerticalAlignment="Top" Width="100" Click="Validate"/>
    </Grid>
</Window>