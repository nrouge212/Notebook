<Window x:Class="Notebook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carnet de notes" Height="450" Width="800">
    <Grid Background="#FFFFFF">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Cahier de notes" 
                   FontSize="40" 
                   FontWeight="SemiBold"
                   Foreground="#1F2937"
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,40"/>

            <!-- Bouton 1 : Saisir les matières -->
            <Button Content="Saisir les matières" 
                Width="200" 
                Height="45" 
                Margin="0,0,0,20" 
                Click="GoEditUnits"/>

            <!-- Bouton 2 : Rentrer un examen -->
            <Button Content="Rentrer un examen" 
                Width="200" 
                Height="45" 
                Margin="0,0,0,20" 
                Click="GoCreateExam"/>

            <!-- Bouton 3 : Afficher les moyennes -->
            <Button Content="Afficher les moyennes" 
                Width="200" 
                Height="45"/>

        </StackPanel>

    </Grid>
</Window>