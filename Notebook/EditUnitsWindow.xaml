<Window x:Class="Notebook.EditUnitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Units" Height="350" Width="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Colonne de gauche : Les Unités -->
        <Label Content="Courses Units :" HorizontalAlignment="Left" Margin="20,10,0,0" VerticalAlignment="Top" Grid.Column="0"/>

        <!-- Ajout de l'événement SelectionChanged demandé par le TP -->
        <ListBox x:Name="units" Margin="20,40,20,80" MouseDoubleClick="EditUnit" SelectionChanged="SelectUnit" Grid.Column="0"/>

        <Button Content="Add" HorizontalAlignment="Left" Margin="20,260,0,0" VerticalAlignment="Top" Width="70" Click="AddUnit" Grid.Column="0"/>
        <Button Content="Remove" HorizontalAlignment="Right" Margin="0,260,20,0" VerticalAlignment="Top" Width="70" Click="RemoveUnit" Grid.Column="0"/>

        <!-- Colonne de droite : Les Modules -->
        <Label Content="Modules :" HorizontalAlignment="Left" Margin="20,10,0,0" VerticalAlignment="Top" Grid.Column="1"/>

        <!-- On ajoute MouseDoubleClick="EditModule" -->
        <ListBox x:Name="modules" Margin="20,40,20,80" MouseDoubleClick="EditModule" Grid.Column="1"/>

        <!-- On ajoute les événements Click -->
        <Button Content="Add" HorizontalAlignment="Left" Margin="20,260,0,0" VerticalAlignment="Top" Width="70" Click="AddModule" Grid.Column="1"/>
        <Button Content="Remove" HorizontalAlignment="Right" Margin="0,260,20,0" VerticalAlignment="Top" Width="70" Click="RemoveModule" Grid.Column="1"/>
    </Grid>
</Window>