<Window x:Class="Notebook.EditUnitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Unités et Modules" Height="450" Width="600"
        Background="#FFFFFF" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SECTION UNITÉS (Gauche) -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Content="Unités d'enseignement :" Grid.Row="0" Margin="0,0,0,10"/>

            <ListBox x:Name="units" Grid.Row="1" MouseDoubleClick="EditUnit" SelectionChanged="SelectUnit"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="Ajouter" Width="90" Margin="0,0,10,0" Click="AddUnit"/>
                <Button Content="Supprimer" Width="90" Background="#DC2626" Click="RemoveUnit"/>
            </StackPanel>
        </Grid>

        <!-- SECTION MODULES (Droite) -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Content="Modules de l'unité :" Grid.Row="0" Margin="0,0,0,10"/>

            <ListBox x:Name="modules" Grid.Row="1" MouseDoubleClick="EditModule"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="Ajouter" Width="90" Margin="0,0,10,0" Click="AddModule"/>
                <Button Content="Supprimer" Width="90" Background="#DC2626" Click="RemoveModule"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>