<Window x:Class="Notebook.EditUnitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Units" Height="350" Width="400">
    <Grid>
        <Label Content="Courses Units :" HorizontalAlignment="Left" Margin="20,10,0,0" VerticalAlignment="Top"/>

        <ListBox x:Name="units" Margin="20,40,20,80" MouseDoubleClick="EditUnit"/>

        <Button Content="Add" HorizontalAlignment="Left" Margin="50,260,0,0" VerticalAlignment="Top" Width="100" Click="AddUnit"/>
        <Button Content="Remove" HorizontalAlignment="Right" Margin="0,260,50,0" VerticalAlignment="Top" Width="100" Click="RemoveUnit"/>
    </Grid>
</Window>